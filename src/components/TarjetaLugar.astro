---
import type { CollectionEntry } from 'astro:content';
import { iconoCategoria } from '../lib/categorias';
import { ruta } from '../lib/rutas';

// CollectionEntry<'museos'> tipa `lugar` como una entrada real de la
// colección "museos" (frontmatter validado por content.config.ts), en vez de
// un objeto genérico — así el editor avisa si se usa un campo que no existe.
interface Props {
	lugar: CollectionEntry<'museos'>;
}

const { lugar } = Astro.props;
const { nombre, descripcion, categoria, horario, entrada, rating, resenas, foto } = lugar.data;
---

<!-- Componente reusable: la ficha con foto + rating + horario que usan tanto
	 la home (index.astro) como las páginas de categoría ([categoria].astro). -->
<li class="tarjeta">
	{/* lugar.id es el nombre del archivo .md (sin extensión), ej. "belgrano".
		Las páginas de detalle siempre viven bajo /museos/<id>, sin importar la
		categoría del lugar. */}
	<a class="tarjeta-link" href={ruta(`/museos/${lugar.id}`)}>
		<div class="foto-wrap">
			{foto ? (
				<img class="foto" src={foto} alt={nombre} loading="lazy" />
			) : (
				// Si no hay foto cargada, cae al ícono de la categoría en vez de
				// dejar un hueco vacío.
				<div class="icono" aria-hidden="true">{iconoCategoria(categoria)}</div>
			)}
			{/* Sin rating (ej. un punto de interés tipo comisaría), no se
				muestra el sello — no tiene sentido "0 ★" ni inventar un número. */}
			{rating && (
				<span class="rating">
					{rating} ★{resenas ? ` (${resenas})` : ''}
				</span>
			)}
		</div>
		<div class="cuerpo">
			<h2>{nombre}</h2>
			<p class="descripcion">{descripcion}</p>
			<div class="meta">
				<span><span class="ic" aria-hidden="true">🕐</span>{horario}</span>
				{entrada && (
					<span><span class="ic" aria-hidden="true">🎫</span>{entrada}</span>
				)}
			</div>
		</div>
	</a>
</li>

<style>
	.tarjeta {
		background: white;
		border-radius: 0.9rem;
		overflow: hidden;
		box-shadow: 0 3px 14px rgba(0, 0, 0, 0.08);
		transition:
			transform 0.18s ease,
			box-shadow 0.18s ease;
	}

	.tarjeta:hover {
		transform: translateY(-4px);
		box-shadow: 0 10px 28px rgba(0, 0, 0, 0.14);
	}

	.tarjeta-link {
		display: block;
		color: inherit;
		text-decoration: none;
	}

	.foto-wrap {
		position: relative;
		height: 160px;
	}

	.foto {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.icono {
		display: flex;
		align-items: center;
		justify-content: center;
		height: 100%;
		font-size: 2.25rem;
		background: linear-gradient(135deg, var(--verde), var(--verde-oscuro));
	}

	.rating {
		position: absolute;
		bottom: 0.6rem;
		left: 0.6rem;
		background: rgba(0, 0, 0, 0.72);
		color: white;
		font-size: 0.8rem;
		font-weight: 600;
		padding: 0.2rem 0.6rem;
		border-radius: 20px;
	}

	.cuerpo {
		padding: 1rem 1.1rem 1.25rem;
	}

	.cuerpo h2 {
		margin: 0 0 0.4rem;
		font-size: 1.1rem;
		color: var(--verde-oscuro);
	}

	.tarjeta-link:hover h2 {
		text-decoration: underline;
	}

	.descripcion {
		margin: 0 0 0.75rem;
		font-size: 0.9rem;
		color: var(--gris);
	}

	.meta {
		font-size: 0.82rem;
		border-top: 1px solid #eee;
		padding-top: 0.6rem;
		display: flex;
		flex-direction: column;
		gap: 0.25rem;
		color: var(--texto);
	}

	.meta span {
		display: flex;
		gap: 0.45rem;
		align-items: flex-start;
	}

	.ic {
		color: var(--tierra);
		flex-shrink: 0;
	}
</style>
