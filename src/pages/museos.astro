---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import TarjetaLugar from '../components/TarjetaLugar.astro';

const museos = await getCollection('museos');
---

<Layout title="Museos" description="Museos de Concepción del Yaguareté Corá, Corrientes.">
	<h1>Museos</h1>
	<p>{museos.length} museos para visitar en el pueblo.</p>

	<ul class="lugares">
		{museos.map((museo) => <TarjetaLugar lugar={museo} />)}
	</ul>
</Layout>

<style>
	.lugares {
		list-style: none;
		margin: 1.5rem 0 0;
		padding: 0;
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
		gap: 1.25rem;
	}
</style>
